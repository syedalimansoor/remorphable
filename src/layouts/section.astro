---
import { ArrowLeftIcon, ArrowRightIcon } from "@phosphor-icons/react";

import { Button } from "../components/button";
import { HeaderLogoLink } from "../components/header-logo-link";
import { ResetProgressButton } from "../components/reset-progress-button";
import type { Page } from "../constants";
import BaseLayout from "../layouts/base.astro";

const { title, previousPath, nextPath, position } = Astro.props;
const pathname = Astro.url.pathname;
---

<BaseLayout title={`${title} | Remorphable`}>
  <main class="flex h-full min-h-0 flex-col gap-2">
    <header class="flex gap-2">
      <HeaderLogoLink client:idle pathname={pathname as Page} />

      <div
        class="grow self-stretch grid grid-cols-[repeat(3,auto)] items-center justify-between px-3 bg-background-200 rounded-lg"
      >
        <span class="text-xs">{position} of 6</span>
        <h1 class="font-display text-blue-500 text-sm">{title}</h1>
        <div><ResetProgressButton client:idle /></div>
      </div>

      <a href={previousPath}>
        <Button size="icon" variant="teal" disabled={!previousPath}>
          <ArrowLeftIcon weight="duotone" size={20} />
        </Button>
      </a>

      <a href={nextPath}>
        <Button disabled={!nextPath}>
          Next
          <ArrowRightIcon weight="duotone" size={20} />
        </Button>
      </a>
    </header>

    <slot />
  </main>
</BaseLayout>
