---
import { cn } from "cn";

const { className } = Astro.props;
---

<p class={cn("mb-4 animate-slide-in", className)}><slot /></p>

<style>
  p :global(b) {
    color: var(--color-blue-500);
  }

  p :global(ul) {
    list-style-type: disc;
    margin-left: 1rem;
  }

  p :global(li:not(:last-child)) {
    margin-bottom: 0.5rem;
  }

  p :global(a) {
    color: var(--color-blue-500);
    text-decoration: underline;
  }
</style>
