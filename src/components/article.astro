---
import LessonNavigation from "./lesson-navigation.astro";
import { LessonConcepts } from "./concept-bank";
import { WaitUntil } from "./wait-until";

const { previousPath, nextPath, page, progress, concepts } = Astro.props;
---

<section
  class="min-h-0 min-w-0 flex-1 overflow-y-auto rounded-lg border py-12 px-8 scrollbar-thumb-border-500 scrollbar-track-transparent scrollbar-gutter-stable"
>
  <div class="mx-auto max-w-[75ch]">
    <slot />
    <WaitUntil client:load page={page} progress={progress}>
      <LessonConcepts client:load concepts={concepts} />
    </WaitUntil>
    <LessonNavigation
      previousPath={previousPath}
      nextPath={nextPath}
      page={page}
      progress={progress}
      hideUntilComplete
      hideNext={page === "conclusion"}
      class="mt-12 border-t pt-6"
    />
  </div>
</section>
