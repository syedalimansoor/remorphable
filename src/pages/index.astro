---
import LogoWithWordmarkWhite from "../assets/logo-with-wordmark-white.svg";
import { Button } from "../components/button";
import BaseLayout from "../layouts/base.astro";
---

<BaseLayout title="Astro">
  <main
    class="rounded-xl bg-blue-500 grid justify-center justify-items-center content-between p-8 text-center text-blue-300"
  >
    <span></span>
    <div class="flex flex-col items-center">
      <LogoWithWordmarkWhite class="mb-5" />
      <p class="text-xl max-w-84 mb-8">
        Learn about morphology by creating your own language!
      </p>
      <a href="/morphology">
        <Button variant="teal" size="lg" className="font-bold">START</Button></a
      >
    </div>
    <span></span>
  </main>
</BaseLayout>
